generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  email          String               @unique
  username       String?
  passwordHash   String
  role           Role                 @default(USER)
  emailVerified  DateTime?
  createdAt      DateTime             @default(now())
  verification   EmailVerification?
  sessions       Session[]
}

model EmailVerification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  userId     String   @unique @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Session {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String   @unique
  expiresAt  DateTime
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

/// Shop catalogue. Managed from /admin — never edit product rows by hand.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String
  category    String
  icon        String   @default("ToolIcon")
  /// Whole Kenyan shillings. Null means "ask us" — the item cannot be bought online.
  price       Int?
  /// Either a path under /public, an absolute URL, or /api/images/<id>.
  image       String?
  badge       String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Uploaded product photos, stored in the database so they survive
/// deploys on read-only/serverless filesystems.
model ProductImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  data      Bytes
  mimeType  String
  fileName  String?
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// One line on an order. Prices are copied in at checkout so a later
/// catalogue edit never rewrites the history of what someone paid.
type OrderItem {
  productId String
  name      String
  unitPrice Int
  quantity  Int
}

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  /// Our own reference, also sent to PayHero as `external_reference`.
  reference      String      @unique
  customerName   String
  phone          String
  email          String?
  notes          String?
  deliveryMethod String      @default("pickup")
  /// "mpesa" pays by STK push; "cash" is settled in person and agreed on WhatsApp.
  paymentMethod  String      @default("mpesa")
  items          OrderItem[]
  total          Int
  status         OrderStatus @default(PENDING)
  /// M-Pesa receipt number once the payment clears.
  mpesaReceipt   String?
  /// PayHero's own reference for the STK push.
  providerRef    String?
  failureReason  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
